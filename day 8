### 2. Code Implementation – Key Manager

**File: `key_manager.py`**

```python
import os
import json
import base64

from pqcrypto.kem.ml_kem_768 import keygen


class KeyManager:

    def __init__(self, storage_dir="keys"):
        self.storage_dir = storage_dir
        os.makedirs(storage_dir, exist_ok=True)

    def generate_keys(self, key_id):

        public_key, private_key = keygen()

        public_path = os.path.join(
            self.storage_dir,
            f"{key_id}_public.key"
        )

        private_path = os.path.join(
            self.storage_dir,
            f"{key_id}_private.key"
        )

        # Store public key
        with open(public_path, "wb") as file:
            file.write(public_key)

        # Restrict permissions on POSIX systems
        fd = os.open(
            private_path,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL,
            0o600
        )

        with os.fdopen(fd, "wb") as file:
            file.write(private_key)

        return {
            "key_id": key_id,
            "public_key_path": public_path,
            "private_key_path": private_path
        }

    def load_public_key(self, key_id):

        path = os.path.join(
            self.storage_dir,
            f"{key_id}_public.key"
        )

        with open(path, "rb") as file:
            return file.read()

    def load_private_key(self, key_id):

        path = os.path.join(
            self.storage_dir,
            f"{key_id}_private.key"
        )

        with open(path, "rb") as file:
            return file.read()
```

