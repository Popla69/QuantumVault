### 2. Code Implementation – Security Testing

**File: `test_security.py`**

```python
import pytest

from pqcrypto.kem.ml_kem_768 import keygen

from crypto_service import (
    encrypt_file_data,
    decrypt_file_data
)


def setup_encryption():
    public_key, private_key = keygen()

    original_data = (
        b"QuantumVault security validation test"
    )

    package = encrypt_file_data(
        public_key,
        original_data
    )

    return private_key, package, original_data


def test_successful_decryption():

    private_key, package, original = setup_encryption()

    recovered = decrypt_file_data(
        private_key,
        package
    )

    assert recovered == original


def test_modified_ciphertext():

    private_key, package, original = setup_encryption()

    package["encrypted_data"] = (
        package["encrypted_data"][:-1]
        + bytes([
            package["encrypted_data"][-1] ^ 1
        ])
    )

    with pytest.raises(Exception):
        decrypt_file_data(private_key, package)


def test_wrong_private_key():

    private_key, package, original = setup_encryption()

    _, wrong_private_key = keygen()

    with pytest.raises(Exception):
        decrypt_file_data(
            wrong_private_key,
            package
        )


if __name__ == "__main__":
    pytest.main([__file__, "-v"])
```

**Run the tests:**

```bash
