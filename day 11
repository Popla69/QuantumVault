## 2. Code Implementation – ML-KEM Validation

**File: `test_pqc.py`**

```python
from pqcrypto.kem.ml_kem_768 import (
    keygen,
    encaps,
    decaps
)


def test_ml_kem_key_generation():

    public_key, private_key = keygen()

    assert len(public_key) == 1184
    assert len(private_key) == 2400

    print("Key generation structure verified")


def test_encapsulation_decapsulation():

    public_key, private_key = keygen()

    ciphertext, sender_secret = encaps(public_key)

    receiver_secret = decaps(
        private_key,
        ciphertext
    )

    assert len(ciphertext) == 1088
    assert len(sender_secret) == 32
    assert sender_secret == receiver_secret

    print("Shared-secret agreement verified")


if __name__ == "__main__":
    test_ml_kem_key_generation()
    test_encapsulation_decapsulation()
```

## 3. Code Implementation – Hybrid Integration Check

**File: `test_hybrid.py`**

```python
from pqcrypto.kem.ml_kem_768 import keygen

from crypto_service import (
    encrypt_data_hybrid,
    decrypt_data_hybrid
)


def test_hybrid_encryption():

    public_key, private_key = keygen()

    original_data = (
        b"QuantumVault hybrid encryption validation"
    )

    package = encrypt_data_hybrid(
        public_key,
        original_data
    )

    recovered_data = decrypt_data_hybrid(
        private_key,
        package
    )

    assert recovered_data == original_data

    print("Hybrid encryption round-trip verified")


if __name__ == "__main__":
    test_hybrid_encryption()
```

