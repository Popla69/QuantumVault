### 2. Code Implementation

**Installation:**
```bash
pip install pqcrypto
```

**File: `pqc.py`**

```python
from pqcrypto.kem.ml_kem_768 import (
    keygen,
    encaps,
    decaps
)
from secrets import compare_digest


def generate_keypair():
    public_key, private_key = keygen()
    return public_key, private_key


def encapsulate(public_key):
    ciphertext, shared_secret = encaps(public_key)
    return ciphertext, shared_secret


def decapsulate(private_key, ciphertext):
    return decaps(private_key, ciphertext)


if __name__ == "__main__":

    # Generate ML-KEM-768 key pair
    public_key, private_key = generate_keypair()

    # Sender encapsulates a shared secret
    ciphertext, sender_secret = encapsulate(public_key)

    # Receiver decapsulates the ciphertext
    receiver_secret = decapsulate(
        private_key,
        ciphertext
    )

    # Verify shared-secret agreement
    result = compare_digest(
        sender_secret,
        receiver_secret
    )

    print("ML-KEM-768 Key Exchange")
    print("----------------------")
    print("Public Key Size:", len(public_key))
    print("Private Key Size:", len(private_key))
    print("Ciphertext Size:", len(ciphertext))
    print("Shared Secret Size:", len(sender_secret))
    print("Shared Secrets Match:", result)

    assert result
```

