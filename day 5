import os
from cryptography.hazmat.primitives.ciphers.aead import AESGCM


def encrypt_data(aes_key, plaintext):
    nonce = os.urandom(12)

    aes = AESGCM(aes_key)

    encrypted_data = aes.encrypt(
        nonce,
        plaintext,
        b"QuantumVault-v1"
    )

    return nonce, encrypted_data


def decrypt_data(aes_key, nonce, encrypted_data):
    aes = AESGCM(aes_key)

    plaintext = aes.decrypt(
        nonce,
        encrypted_data,
        b"QuantumVault-v1"
    )

    return plaintext
```

**File: `crypto_service.py`**

```python
import os

from pqcrypto.kem.ml_kem_768 import (
    keygen, encaps, decaps
)

from key_derivation import derive_aes_key
from symmetric import encrypt_data, decrypt_data


def encrypt_file_data(public_key, file_data):

    # Establish a shared secret
    kem_ciphertext, shared_secret = encaps(public_key)

    # Derive the AES encryption key
    salt = os.urandom(16)
    aes_key = derive_aes_key(shared_secret, salt)

    # Encrypt file data
    nonce, encrypted_data = encrypt_data(
        aes_key,
        file_data
    )

    return {
        "kem_ciphertext": kem_ciphertext,
        "salt": salt,
        "nonce": nonce,
        "encrypted_data": encrypted_data
    }


def decrypt_file_data(private_key, package):

    # Recover the shared secret
    shared_secret = decaps(
        private_key,
        package["kem_ciphertext"]
    )

    # Reconstruct the AES key
    aes_key = derive_aes_key(
        shared_secret,
        package["salt"]
    )

    # Decrypt and authenticate file data
    return decrypt_data(
        aes_key,
        package["nonce"],
        package["encrypted_data"]
    )
```

