### 2. Code Implementation – Input Validation

**File: `symmetric.py`**

```python
import os
from cryptography.hazmat.primitives.ciphers.aead import AESGCM


def encrypt_data(aes_key, plaintext):

    if len(aes_key) != 32:
        raise ValueError("Invalid AES-256 key length")

    if not isinstance(plaintext, bytes):
        raise TypeError("Plaintext must be bytes")

    nonce = os.urandom(12)

    aes = AESGCM(aes_key)

    ciphertext = aes.encrypt(
        nonce,
        plaintext,
        b"QuantumVault-v1"
    )

    return nonce, ciphertext


def decrypt_data(aes_key, nonce, ciphertext):

    if len(aes_key) != 32:
        raise ValueError("Invalid AES key length")

    if len(nonce) != 12:
        raise ValueError("Invalid nonce length")

    aes = AESGCM(aes_key)

    try:
        return aes.decrypt(
            nonce,
            ciphertext,
            b"QuantumVault-v1"
        )

    except Exception:
        raise ValueError(
            "Decryption failed: authentication error"
        ) from None
```

### 3. Code Implementation – Package Validation

**File: `package_validator.py`**

```python
def validate_package(package):

    required_fields = {
        "kem_ciphertext",
        "salt",
        "nonce",
        "ciphertext"
    }

    if not isinstance(package, dict):
        raise TypeError("Package must be a dictionary")

    if not required_fields.issubset(package):
        raise ValueError("Missing package components")

    if len(package["salt"]) != 16:
        raise ValueError("Invalid salt length")

    if len(package["nonce"]) != 12:
        raise ValueError("Invalid nonce length")

    if not package["ciphertext"]:
        raise ValueError("Empty ciphertext")

    return True
```

### 4. Testing Approach

